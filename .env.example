# local: fixtures explícitas; supabase: banco remoto obrigatório
DATA_SOURCE=local
# O cliente usa a API persistida somente quando este valor é supabase.
NEXT_PUBLIC_DATA_SOURCE=local
# Somente sessões criadas neste modo podem ser removidas pelo reset demonstrativo.
MIPO_DEMO_MODE=true
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Use a secret key (sb_secret_...) or, temporariamente, a service_role legada.
SUPABASE_SECRET_KEY=
# Agente ReAct server-side. Nunca use prefixo NEXT_PUBLIC_ nestas variáveis.
AI_EXPLANATIONS_ENABLED=false
ELOAGENTS_BASE_URL=https://chat.eloagents.click/api
ELOAGENTS_API_KEY=
ELOAGENTS_MODEL=gpt-54-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_PROVIDER_TIMEOUT_MS=12000
MIPO_PYTHON_AGENT_URL=http://127.0.0.1:8000
MIPO_PYTHON_AGENT_TIMEOUT_MS=30000
# Opcional: protege o processo Python quando ele não estiver restrito ao host local.
MIPO_PYTHON_AGENT_TOKEN=
# Orçamento total do grafo, além do timeout individual de cada provider.
MIPO_AGENT_TOTAL_TIMEOUT_MS=30000
