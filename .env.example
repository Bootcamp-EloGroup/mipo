# local: fixtures explícitas; supabase: banco remoto obrigatório
DATA_SOURCE=local
# O cliente usa a API persistida somente quando este valor é supabase.
NEXT_PUBLIC_DATA_SOURCE=local
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Use a secret key (sb_secret_...) or, temporariamente, a service_role legada.
SUPABASE_SECRET_KEY=
